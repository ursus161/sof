# Copy to voice-loop.env (git-ignored) and adjust.

# ssh target with key auth (BatchMode, no password prompts)
EVK_HOST=root@imx8mp-evk

# Firmware build, run from WEST_TOP (the west workspace holding sof/)
#WEST_TOP=$HOME/work/sof-ws
#BUILD_CMD="sof/scripts/xtensa-build-zephyr.py imx8m"
#FW_IMAGE=$WEST_TOP/build-sof-staging/sof/imx/sof/sof-imx8m.ri

# Topology target (tools/topology/topology1/CMakeLists.txt)
TPLG_NAME=sof-imx8mp-wm8960-aec

# How the target reloads SOF after new files are copied
#RELOAD_CMD="modprobe -r snd_sof_imx8 && modprobe snd_sof_imx8"

# PCMs on the target (check with: aplay -l / arecord -l)
PLAY_PCM=hw:0,0
RAW_PCM=hw:0,1
VOICE_PCM=hw:0,2

# Gates enforced by voice_metrics.py: nr, erle, xrun
#   NS-only stage (P2):  nr,xrun
#   AEC stage (P3+):     erle,nr,xrun
GATES=nr,xrun

# Optional 48 kHz S16 WAV used as far-end audio (music works best)
#FAR_END_WAV=$HOME/music/test-48k.wav
