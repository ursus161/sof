# Copy to voice-loop.env (git-ignored) and adjust.

# --- build -----------------------------------------------------------------
# West workspace that holds sof/; the firmware build runs from there.
#WEST_TOP=$HOME/work/sof-ws
#BUILD_CMD="sof/scripts/xtensa-build-zephyr.py imx8m"
#FW_IMAGE=$WEST_TOP/build-sof-staging/sof/imx/sof/sof-imx8m.ri
# topology1 target (tools/topology/topology1/CMakeLists.txt).
# Until the AEC topology exists, use an existing one, e.g. sof-imx8mp-micfil.
TPLG_NAME=sof-imx8mp-wm8960-aec

# --- stimulus ----------------------------------------------------------------
# Real recordings give meaningful scores; defaults are synthetic.
#STIM_ARGS="--far-wav $HOME/audio/music-48k.wav --near-wav $HOME/audio/speech-48k.wav --ir-wav $HOME/audio/evk-ir-48k.wav"

# --- bench (host testbench, deterministic) -----------------------------------
# IPC3 testbench built with scripts/rebuild-testbench.sh
#TESTBENCH=$PWD/tools/testbench/build_testbench/install/bin/sof-testbench
# Testbench topology with file endpoints for the voice chain (P1 task).
#BENCH_TPLG=$PWD/scripts/voice-loop/out/build-tplg/.../test-voice-imx8mp.tplg
#BENCH_PIPES=1,2
BENCH_GATES=erle,nr,near,dt,dtsdr

# --- evk (acoustic) ------------------------------------------------------------
# ssh target with key auth (no password prompts)
EVK_HOST=root@imx8mp-evk
#RELOAD_CMD="modprobe -r snd_sof_imx8 && modprobe snd_sof_imx8"
# PCMs on the target (aplay -l / arecord -l)
PLAY_PCM=hw:0,0
RAW_PCM=hw:0,1
VOICE_PCM=hw:0,2
# Near-end talker: a second device next to the EVK mics, run on this host.
# {wav} is replaced with near.wav. Leave empty to skip the near-end gate.
#NEAR_PLAY_CMD="aplay -q -D default {wav}"

# Gates (thresholds in voice_metrics.py, override with --set):
#   erle >= 25 dB, nr >= 10 dB, near (loss) <= 3 dB,
#   dt (near gain in double talk) >= -6 dB, dtsdr >= 12 dB, xrun == 0
#   NS-only stage (P2):  nr,near,xrun
#   AEC stage (P3+):     erle,nr,near,xrun
GATES=nr,near,xrun
